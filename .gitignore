__pycache__/
*.pyc
.venv/
venv/

# Warehouse: the DuckDB file and Parquet extracts are rebuildable from the ingesters.
# The manifest (small, human-readable) IS committed.
warehouse/*.duckdb
warehouse/*.duckdb.wal
warehouse/*.parquet

# Scratch analysis
explorations/*.ipynb
!explorations/*.example.ipynb

# samples/: keep the READMEs + small data samples (json/csv/txt); raw pages + PDFs
# are large and re-fetchable via `python3 tools/sample.py <id>`
samples/**/page.html
samples/**/*.pdf
